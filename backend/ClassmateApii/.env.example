# =========================
# Database
# =========================
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=classmate_dev;Username=postgres;Password=postgres

# =========================
# JWT
# =========================
Jwt__Secret=your-super-secret-key-minimum-32-characters
Jwt__Issuer=classmate-api
Jwt__Audience=classmate-frontend
Jwt__ExpiryHours=24

# =========================
# Google OAuth
# =========================
Google__ClientId=your-google-client-id.apps.googleusercontent.com
Google__ClientSecret=your-google-client-secret

# =========================
# Frontend
# =========================
Frontend__Url=http://localhost:3000

# =========================
# ASP.NET Environment
# =========================
ASPNETCORE_ENVIRONMENT=Development